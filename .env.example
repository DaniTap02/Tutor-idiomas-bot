# Copia este archivo como .env y llena tus valores. El .env NUNCA se sube al repositorio.

# --- Telegram (obligatorio): token de @BotFather ---
TELEGRAM_BOT_TOKEN=tu_token_aqui

# --- Lara Translate (opcional): traducción y detección de idioma por MCP ---
# Se crean en https://laratranslate.com/account (sección API) después de suscribirte a un plan,
# también el gratis (https://laratranslate.com/pricing). El Secret solo se ve una vez: guárdalo.
# Sin estas dos líneas el bot funciona igual, pero sin /traducir ni detección de idioma.
LARA_ACCESS_KEY_ID=
LARA_ACCESS_KEY_SECRET=

# --- Opcionales (todas tienen un valor por defecto; ver README) ---
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_TIMEOUT=120
# LARA_TIMEOUT=15
# LARA_INICIO_TIMEOUT=90
